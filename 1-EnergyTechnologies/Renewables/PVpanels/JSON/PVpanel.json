        {
            "var_name": "T_panel",
            "type": "CALCULATED",
            "full_name": "Panel temperature",
            "user_grade": "MANDATORY",
            "value": 290.13465517241383,
            "physical_unit": "K",
            "formula": "(U_glass*(T_ext+273.15))/(U_glass-efficiency_var*GI)+GI*(f_glass-efficiency_ref-efficiency_var*T_ref)/(U_glass-efficiency_var*GI)",
            "min_bound": null,
            "max_bound": null,
            "latex_syntax": "$T_{panel}$",
            "reference": "Ashouri (2014)",
            "description": "Temperature of the panel, from its energy balance: the absorbed irradiance not converted to electricity is lost to the ambient air"
        },
        {
            "var_name": "size_real",
            "type": "CALCULATED",
            "full_name": "Panel area",
            "user_grade": "MANDATORY",
            "value": 4000.0,
            "physical_unit": "m2",
            "formula": "size_ref*area_factor",
            "min_bound": null,
            "max_bound": null,
            "latex_syntax": "$A_{PV}$",
            "reference": "PVpanel2_ETraluca.lua",
            "description": "Area effectively covered by PV panels"
        },
        {
            "var_name": "efficiency",
            "type": "CALCULATED",
            "full_name": "Panel efficiency",
            "user_grade": "MANDATORY",
            "value": 0.14786534482758618,
            "physical_unit": "-",
            "formula": "efficiency_ref-efficiency_var*(T_panel-T_ref)",
            "min_bound": null,
            "max_bound": null,
            "latex_syntax": "$\\eta_{PV}$",
            "reference": "Ashouri (2014)",
            "description": "Electrical efficiency of the panel at its operating temperature"
        },
        {
            "var_name": "E_default",
            "type": "CALCULATED",
            "full_name": "Electricity production",
            "user_grade": "MANDATORY",
            "value": 59.146137931034474,
            "physical_unit": "kW",
            "formula": "GI*size_real*efficiency/param_electricity",
            "min_bound": null,
            "max_bound": null,
            "latex_syntax": "$\\dot E_{PV}$",
            "reference": "Ashouri (2014)",
            "description": "Electric power produced by the panels"
        },
        {
            "var_name": "Annuity",
            "type": "CALCULATED",
            "full_name": "Annualization factor",
            "user_grade": "MANDATORY",
            "value": 0.10185220882315059,
            "physical_unit": "-",
            "formula": "(i*(1+i)**n)/((1+i)**n-1)",
            "min_bound": null,
            "max_bound": null,
            "latex_syntax": "$a$",
            "reference": "PVpanel2_ETraluca.lua",
            "description": "Annualization factor over n years at the interest rate i"
        },
        {
            "var_name": "Cinv2",
            "type": "CALCULATED",
            "full_name": "Annualized investment",
            "user_grade": "MANDATORY",
            "value": 61111.32529389035,
