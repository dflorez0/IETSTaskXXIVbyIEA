        {
            "var_name": "ro_air",
            "type": "CALCULATED",
            "full_name": "Air density",
            "user_grade": "MANDATORY",
            "value": 1.1845814187489518,
            "physical_unit": "kg/m3",
            "formula": "1.293*273.15/(T_ext+273.15)",
            "min_bound": null,
            "max_bound": null,
            "latex_syntax": "$\\rho_{air}$",
            "reference": "Du and Aziz (2022)",
            "description": "Density of the air at the ambient temperature, from 1.293 kg/m3 at 0 °C"
        },
        {
            "var_name": "A_rotor",
            "type": "CALCULATED",
            "full_name": "Swept area",
            "user_grade": "MANDATORY",
            "value": 5281.016152,
            "physical_unit": "m2",
            "formula": "0.25*pi*d_rotor**2",
            "min_bound": null,
            "max_bound": null,
            "latex_syntax": "$A_{rotor}$",
            "reference": "Du and Aziz (2022)",
            "description": "Area swept by the rotor"
        },
        {
            "var_name": "V_real",
            "type": "CALCULATED",
            "full_name": "Wind speed at hub height",
            "user_grade": "MANDATORY",
            "value": 9.811327233930726,
            "physical_unit": "m/s",
            "formula": "V_mea*(z_rotor/z_mea)**shear_exp",
            "min_bound": null,
            "max_bound": null,
            "latex_syntax": "$V_{hub}$",
            "reference": "Du and Aziz (2022)",
            "description": "Wind speed at the hub height, from the measured speed with the power law of the wind shear"
        },
        {
            "var_name": "E_wind",
            "type": "CALCULATED",
            "full_name": "Wind power",
            "user_grade": "MANDATORY",
            "value": 2954.1714635739586,
            "physical_unit": "kW",
            "formula": "(0.5*N_WT*ro_air*A_rotor*V_real**3)/1000",
            "min_bound": null,
            "max_bound": null,
            "latex_syntax": "$\\dot E_{wind}$",
            "reference": "Du and Aziz (2022)",
            "description": "Kinetic power of the wind through the swept area"
        },
        {
            "var_name": "P_WT_rated",
            "type": "CALCULATED",
            "full_name": "Rated power",
            "user_grade": "MANDATORY",
            "value": 5405.0056753872595,
            "physical_unit": "kW",
            "formula": "(0.5*N_WT*ro_air*A_rotor*12**3)/1000",
            "min_bound": null,
            "max_bound": null,
            "latex_syntax": "$P_{rated}$",
            "reference": "WindTurbine_ET.lua",
            "description": "Wind power through the swept area at the rated wind speed of 12 m/s. As in the Lua file, it does not include the power coefficient and the mechanical efficiency"
        },
        {
            "var_name": "efficiency",
            "type": "CALCULATED",
            "full_name": "Turbine efficiency",
            "user_grade": "MANDATORY",
            "value": 0.441,
            "physical_unit": "-",
            "formula": "eta_mec*co_power",
            "min_bound": null,
            "max_bound": null,
            "latex_syntax": "$\\eta_{WT}$",
            "reference": "Du and Aziz (2022)",
            "description": "Fraction of the wind power converted into electricity"
        },
        {
            "var_name": "P_WT",
            "type": "CALCULATED",
            "full_name": "Electricity production",
            "user_grade": "MANDATORY",
            "value": 1302.789615436116,
            "physical_unit": "kW",
            "formula": "(0.5*N_WT*ro_air*A_rotor*eta_mec*co_power*V_real**3)/1000",
            "min_bound": null,
            "max_bound": null,
            "latex_syntax": "$P_{WT}$",
            "reference": "Du and Aziz (2022)",
            "description": "Electric power of the turbine. Between the cut-in speed of 3 m/s and the rated speed of 12 m/s it follows the cube of the hub wind speed, as here; between 12 and 25 m/s it stays at its value at 12 m/s; below 3 m/s and above the cut-off speed of 25 m/s it is 0. The Lua file writes this power curve as a conditional"
        },
        {
            "var_name": "Annuity_fact",
            "type": "CALCULATED",
            "full_name": "Annualization factor",
            "user_grade": "MANDATORY",
            "value": 0.10185220882315059,
            "physical_unit": "-",
            "formula": "(i*(i+1)**n)/((i+1)**n-1)",
            "min_bound": null,
            "max_bound": null,
            "latex_syntax": "$a$",
            "reference": "WindTurbine_ET.lua",
            "description": "Annualization factor over n years at the interest rate i"
        },
        {
            "var_name": "Cinv2",
            "type": "CALCULATED",
            "full_name": "Annualized investment",
            "user_grade": "MANDATORY",
            "value": 790534.897038435,
            "physical_unit": "USD/year",
            "formula": "cost_capex_WT*P_WT_rated*Annuity_fact",
            "min_bound": null,
            "max_bound": null,
            "latex_syntax": "$C^{inv}_{WT}$",
            "reference": "WindTurbine_ET.lua",
            "description": "Annualized investment cost of the wind turbine (not used: the unit's Cinv2 is 0 in the Lua file)"
        }
    ],
