    "Last Update Date": "2025-10-08",
    "Keywords": "Heat Supply, Natural Gas, Fossil, Combustion, Furnace, High Temperature Heat",
    "Reference Capacity": "1000 kW",
    "Description": "This model represents a furnace using natural gas for heat supply.",
